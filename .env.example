# Optional external service endpoint used when replacing the local AI Route Handler.
# AI_PROVIDER_BASE_URL=https://example.com
# AI_PROVIDER_API_KEY=server-only-secret

# PostgreSQL is optional during UI development. When set, all product and user reads use it.
DATABASE_URL=postgresql://react_h5:react_h5@localhost:5432/react_h5

# Generate a long random value for production. Never expose it as NEXT_PUBLIC_*.
AUTH_SECRET=replace-with-a-long-random-production-secret
