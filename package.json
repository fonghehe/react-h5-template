{
  "name": "react-h5-template-monorepo",
  "version": "3.0.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.16.0",
  "engines": {
    "node": ">=22.18.0",
    "pnpm": ">=11.0.0"
  },
  "scripts": {
    "dev": "turbo-run dev",
    "dev:all": "turbo run dev --filter=@rh5/h5-* --filter=@rh5/docs",
    "dev:antd": "pnpm --filter @rh5/h5-antd-mobile dev",
    "dev:nutui": "pnpm --filter @rh5/h5-nutui dev",
    "dev:arco": "pnpm --filter @rh5/h5-arco-mobile dev",
    "dev:docs": "pnpm --filter @rh5/docs dev",
    "build": "turbo build",
    "build:antd": "pnpm --filter @rh5/h5-antd-mobile build",
    "build:nutui": "pnpm --filter @rh5/h5-nutui build",
    "build:arco": "pnpm --filter @rh5/h5-arco-mobile build",
    "build:docs": "pnpm --filter @rh5/docs build",
    "lint": "pnpm format:check && pnpm lint:ox && pnpm lint:eslint",
    "lint:eslint": "eslint . --cache",
    "lint:ox": "oxlint --type-aware --threads=4",
    "typecheck": "turbo typecheck",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "test:e2e:antd": "cross-env E2E_APP=antd playwright test",
    "test:e2e:nutui": "cross-env E2E_APP=nutui playwright test",
    "test:e2e:arco": "cross-env E2E_APP=arco playwright test",
    "api:generate": "orval --config orval.config.ts",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:seed": "tsx scripts/db-seed.ts",
    "db:setup": "pnpm db:migrate && pnpm db:seed",
    "format": "oxfmt --threads=4 && oxlint --fix --type-aware --threads=4 && eslint . --cache --fix",
    "format:check": "oxfmt --check --threads=4",
    "check": "pnpm lint && pnpm typecheck && pnpm test && pnpm build"
  },
  "devDependencies": {
    "@rh5/turbo-run": "workspace:*",
    "@faker-js/faker": "^10.1.0",
    "@next/env": "16.3.4",
    "@playwright/test": "^1.62.1",
    "@types/node": "^26.1.2",
    "@vitest/coverage-v8": "4.1.10",
    "cross-env": "^10.1.0",
    "drizzle-kit": "^0.31.10",
    "drizzle-orm": "^0.45.2",
    "eslint": "^9.39.1",
    "eslint-config-next": "16.3.4",
    "jsdom": "^29.1.1",
    "orval": "^8.5.3",
    "oxfmt": "^0.61.0",
    "oxlint": "^1.76.0",
    "oxlint-tsgolint": "^7.0.2001",
    "pg": "^8.23.0",
    "tsx": "^4.23.13",
    "turbo": "^2.10.7",
    "typescript": "^6.0.2",
    "vitepress": "^1.6.4",
    "vitest": "4.1.10"
  }
}
